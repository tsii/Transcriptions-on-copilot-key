[Unit]
Description=STT Push-to-Talk (Copilot key -> ASR -> text)
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
# @EXEC@ is set at install time (Weg B: system python3 + user site):
#   .deb:  /usr/bin/stt-button run
#   dev:   launched via the repo launcher script
ExecStart=@EXEC@
Restart=on-failure
RestartSec=3
Environment=HF_HOME=%h/.cache/huggingface

[Install]
WantedBy=default.target
